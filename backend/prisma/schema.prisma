// This is your Prisma schema file for ElderCare Advanced with Smart Home & Extreme Safety Module

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE USER & ELDER MANAGEMENT
// ============================================================================

enum UserRole {
  ADMIN
  CLINICIAN
  CAREGIVER
  FAMILY
  ELDER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  elderProfile           ElderProfile?
  createdAutomationRules AutomationRule[]
  issuedActuatorCommands ActuatorCommand[]
  roles                  UserRole[]

  @@map("users")
}

model ElderProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  dateOfBirth     DateTime
  gender          String
  medicalRecordNo String    @unique
  firstName       String    // Added for emergency reports
  lastName        String    // Added for emergency reports
  bloodType       String?   // Added for emergency reports
  address         String?
  city            String?   // Added for emergency reports
  state           String?   // Added for emergency reports
  zipCode         String?   // Added for emergency reports
  emergencyContact Json?    // { name, relationship, phone }
  medicalConditions Json?   // Array of conditions
  allergies        Json?    // Array of allergies
  notes           String?
  status          String    @default("ACTIVE") // ACTIVE, INACTIVE, HOSPITALIZED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  home               Home?
  vitals             VitalReading[]
  alerts             Alert[]
  inactivityProfiles InactivityProfile[]
  helpTriggers       HelpTrigger[]
  carePlan           CarePlan?
  appointments       Appointment[]
  medications        Medication[]

  // Emergency Monitoring Relations
  healthcareProviders HealthcareProvider[]
  emergencyServices   EmergencyService[]
  emergencyReports    EmergencyReport[]
  emergencyDispatches EmergencyDispatch[]
  medicalHistory      MedicalHistory?
  emergencyContacts   EmergencyContact[]
  monitoringConfig    MonitoringConfig?

  // Voice Control Relations
  voiceCommands       VoiceCommand[]
  voiceExecutions     VoiceExecution[]
  voicePreference     VoicePreference?

  // AI Companion Relations
  companionSettings       CompanionSettings?
  companionConversations  CompanionConversation[]
  companionReminders      CompanionReminder[]
  companionActivities     CompanionActivity[]

  // ML & Analytics Relations
  mlPredictions           MLPrediction[]
  gaitAnalyses            GaitAnalysis[]
  locationTracking        LocationTracking[]

  @@map("elder_profiles")
}

// ============================================================================
// VITALS & ALERTS (Existing System)
// ============================================================================

enum VitalType {
  BLOOD_PRESSURE
  HEART_RATE
  TEMPERATURE
  GLUCOSE
  SPO2
  WEIGHT
  RESPIRATORY_RATE
}

model VitalReading {
  id          String    @id @default(uuid())
  elderId     String
  vitalType   VitalType
  value       Float
  unit        String
  systolic    Float?    // For blood pressure
  diastolic   Float?    // For blood pressure
  deviceId    String?
  recordedAt  DateTime  @default(now())
  notes       String?
  createdAt   DateTime  @default(now())

  // Relations
  elder ElderProfile @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("vital_readings")
}

enum AlertType {
  VITAL_ABNORMAL
  MEDICATION_MISSED
  APPOINTMENT_REMINDER
  FALL_DETECTED
  SMART_HOME_SMOKE
  SMART_HOME_GAS
  SMART_HOME_WATER_LEAK
  SMART_HOME_FALL_UNRESPONSIVE
  SMART_HOME_DOOR_OPEN_NIGHT
  SMART_HOME_INACTIVITY
  SMART_HOME_TEMPERATURE_EXTREME
  SMART_HOME_CUSTOM
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

model Alert {
  id          String        @id @default(uuid())
  elderId     String
  type        AlertType
  severity    AlertSeverity
  status      AlertStatus   @default(ACTIVE)
  title       String
  message     String
  metadata    Json?         // Additional context

  // Smart Home specific references
  sourceSensorEventId         String?
  sourceEmergencyScenarioId   String?

  triggeredAt DateTime  @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  elder                ElderProfile       @relation(fields: [elderId], references: [id], onDelete: Cascade)
  sourceSensorEvent    SensorEvent?       @relation(fields: [sourceSensorEventId], references: [id])
  sourceEmergencyScenario EmergencyScenario? @relation(fields: [sourceEmergencyScenarioId], references: [id])
  emergencyNotifications EmergencyNotification[]

  @@map("alerts")
}

// ============================================================================
// SMART HOME: HOME & ZONES
// ============================================================================

model Home {
  id        String   @id @default(uuid())
  elderId   String   @unique
  name      String
  address   String
  timezone  String   @default("America/New_York")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  elder                    ElderProfile            @relation(fields: [elderId], references: [id], onDelete: Cascade)
  zones                    HomeZone[]
  devices                  Device[]
  sensorEvents             SensorEvent[]
  actuatorCommands         ActuatorCommand[]
  automationRules          AutomationRule[]
  emergencyScenarios       EmergencyScenario[]
  inactivityProfiles       InactivityProfile[]
  iotTokens                IotToken[]
  helpTriggers             HelpTrigger[]
  emergencyScenarioInstances EmergencyScenarioInstance[]
  voiceCommands            VoiceCommand[]
  voiceExecutions          VoiceExecution[]
  cameras                  Camera[]

  @@map("homes")
}

model HomeZone {
  id             String  @id @default(uuid())
  homeId         String
  name           String  // "Bedroom", "Bathroom", "Kitchen", etc.
  description    String?
  floor          String? // "1st Floor", "2nd Floor", etc.
  isCriticalArea Boolean @default(false) // bathroom, stairs, kitchen
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  home    Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  devices Device[]

  @@map("home_zones")
}

// ============================================================================
// SMART HOME: DEVICE TYPES, DEVICES, SENSORS, ACTUATORS
// ============================================================================

enum DeviceCategory {
  SENSOR
  ACTUATOR
  HYBRID
}

model DeviceType {
  id                 String         @id @default(uuid())
  name               String         // "Ceiling Motion Sensor", "Smart Door Lock", etc.
  category           DeviceCategory
  capabilitiesJson   Json           // List of sensors/actuators & metadata
  vendor             String?
  model              String?
  notes              String?
  isDefaultSupported Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  devices Device[]

  @@map("device_types")
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

model Device {
  id              String       @id @default(uuid())
  homeId          String
  zoneId          String?
  deviceTypeId    String
  name            String
  identifier      String       // MAC, serial, hub address
  status          DeviceStatus @default(UNKNOWN)
  batteryLevel    Int?         // 0-100
  lastSeenAt      DateTime?
  firmwareVersion String?
  installedAt     DateTime     @default(now())
  settingsJson    Json?        // Per-device custom settings
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  home             Home              @relation(fields: [homeId], references: [id], onDelete: Cascade)
  zone             HomeZone?         @relation(fields: [zoneId], references: [id])
  deviceType       DeviceType        @relation(fields: [deviceTypeId], references: [id])
  sensors          Sensor[]
  actuators        Actuator[]
  sensorEvents     SensorEvent[]
  actuatorCommands ActuatorCommand[]
  helpTriggers     HelpTrigger[]

  @@unique([homeId, identifier])
  @@map("devices")
}

enum SensorType {
  MOTION
  CONTACT_DOOR
  CONTACT_WINDOW
  SMOKE
  CO2
  GAS_LEAK
  WATER_LEAK
  FALL_DETECTOR
  PRESENCE_BED
  PRESENCE_CHAIR
  TEMPERATURE
  HUMIDITY
  NOISE_LEVEL
  POWER_USAGE
  BUTTON_PANIC
  CUSTOM
}

model Sensor {
  id              String     @id @default(uuid())
  deviceId        String
  sensorType      SensorType
  name            String
  unit            String?    // "°C", "ppm", "dB", etc.
  isCritical      Boolean    @default(false)
  calibrationJson Json?      // Calibration parameters
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  device       Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sensorEvents SensorEvent[]

  @@map("sensors")
}

enum ActuatorType {
  LIGHT
  DOOR_LOCK
  THERMOSTAT
  SIREN
  SPEAKER_TTS
  APPLIANCE_POWER
  CURTAIN_BLINDS
  NOTIFICATION_BRIDGE // soft actuator -> send message
  CUSTOM
}

model Actuator {
  id              String       @id @default(uuid())
  deviceId        String
  actuatorType    ActuatorType
  name            String
  stateSchemaJson Json         // Allowed states & ranges
  isCritical      Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  device           Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  actuatorCommands ActuatorCommand[]

  @@map("actuators")
}

// ============================================================================
// SMART HOME: EVENTS & COMMANDS
// ============================================================================

enum SensorEventType {
  VALUE_READING   // continuous numeric
  STATE_CHANGE    // e.g. open/closed
  ALERT           // smoke detected, etc.
  HEARTBEAT
  ERROR
  CUSTOM
}

model SensorEvent {
  id             String          @id @default(uuid())
  homeId         String
  deviceId       String
  sensorId       String
  eventType      SensorEventType
  valueNumeric   Float?
  valueText      String?         // "OPEN", "CLOSED", "ON", "OFF", etc.
  severity       AlertSeverity   @default(INFO)
  rawPayloadJson Json?           // Raw hub payload
  occurredAt     DateTime
  ingestedAt     DateTime        @default(now())
  processed      Boolean         @default(false)
  processedAt    DateTime?
  createdAt      DateTime        @default(now())

  // Relations
  home   Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  device Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sensor Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  alerts Alert[]

  @@index([homeId, occurredAt])
  @@index([deviceId, occurredAt])
  @@index([sensorId, occurredAt])
  @@index([processed])
  @@map("sensor_events")
}

enum ActuatorCommandStatus {
  PENDING
  SENT
  ACKED
  FAILED
}

model ActuatorCommand {
  id                String                @id @default(uuid())
  homeId            String
  deviceId          String
  actuatorId        String
  commandName       String                // e.g. "SET_STATE"
  commandParamsJson Json                  // e.g. { "on": true } or { "temperature": 22 }
  issuedByUserId    String?               // null => system rule
  issuedByRuleId    String?
  status            ActuatorCommandStatus @default(PENDING)
  errorMessage      String?
  createdAt         DateTime              @default(now())
  sentAt            DateTime?
  ackedAt           DateTime?
  updatedAt         DateTime              @updatedAt

  // Relations
  home        Home             @relation(fields: [homeId], references: [id], onDelete: Cascade)
  device      Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  actuator    Actuator         @relation(fields: [actuatorId], references: [id], onDelete: Cascade)
  issuedByUser User?           @relation(fields: [issuedByUserId], references: [id])
  issuedByRule AutomationRule? @relation(fields: [issuedByRuleId], references: [id])

  @@map("actuator_commands")
}

// ============================================================================
// SMART HOME: AUTOMATION RULES
// ============================================================================

enum AutomationRuleTriggerType {
  SENSOR_EVENT
  SCHEDULED
  INACTIVITY
  COMPOSITE
}

model AutomationRule {
  id                  String                      @id @default(uuid())
  homeId              String
  name                String
  description         String?
  isEnabled           Boolean                     @default(true)
  triggerType         AutomationRuleTriggerType
  triggerConfigJson   Json                        // Trigger-specific configuration
  conditionConfigJson Json?                       // Additional AND/OR conditions
  actionsConfigJson   Json                        // List of actions to execute
  severity            AlertSeverity               @default(INFO)
  createdByUserId     String
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  // Relations
  home              Home              @relation(fields: [homeId], references: [id], onDelete: Cascade)
  createdBy         User              @relation(fields: [createdByUserId], references: [id])
  actuatorCommands  ActuatorCommand[]

  @@map("automation_rules")
}

// ============================================================================
// SMART HOME: EMERGENCY SCENARIOS
// ============================================================================

model EmergencyScenario {
  id                    String    @id @default(uuid())
  homeId                String
  name                  String    // "Fall + No Response", "Smoke + No Response", etc.
  description           String?
  isEnabled             Boolean   @default(true)
  triggerSignatureJson  Json      // Structured trigger conditions
  stepwiseActionsJson   Json      // Array of timed actions with delays
  lastTriggeredAt       DateTime?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  home      Home                        @relation(fields: [homeId], references: [id], onDelete: Cascade)
  instances EmergencyScenarioInstance[]
  alerts    Alert[]

  @@map("emergency_scenarios")
}

enum EmergencyScenarioInstanceStatus {
  ACTIVE
  RESOLVED
  ESCALATED
  CANCELLED
}

model EmergencyScenarioInstance {
  id                   String                          @id @default(uuid())
  scenarioId           String
  homeId               String
  elderId              String
  startedAt            DateTime                        @default(now())
  currentStepIndex     Int                             @default(0)
  status               EmergencyScenarioInstanceStatus @default(ACTIVE)
  relatedSensorEventId String?
  cancelToken          String?                         // Code to allow cancel
  lastActionAt         DateTime?
  resolvedAt           DateTime?
  notes                String?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  // Relations
  scenario EmergencyScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  home     Home              @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@map("emergency_scenario_instances")
}

// ============================================================================
// SMART HOME: INACTIVITY PROFILES
// ============================================================================

model InactivityProfile {
  id         String   @id @default(uuid())
  homeId     String
  elderId    String
  configJson Json     // { wakeHours, maxNoMotionMinutes, nightCheck, etc. }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  home  Home         @relation(fields: [homeId], references: [id], onDelete: Cascade)
  elder ElderProfile @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@unique([homeId, elderId])
  @@map("inactivity_profiles")
}

// ============================================================================
// SMART HOME: HELP & PANIC TRIGGERS
// ============================================================================

enum HelpTriggerType {
  BUTTON_PRESS
  VOICE_KEYWORD
  DEVICE_EVENT
  UNKNOWN
}

model HelpTrigger {
  id              String          @id @default(uuid())
  homeId          String
  elderId         String
  triggerType     HelpTriggerType
  sourceDeviceId  String?
  rawPayloadJson  Json?
  occurredAt      DateTime        @default(now())
  handledAlertId  String?
  notes           String?
  createdAt       DateTime        @default(now())

  // Relations
  home         Home         @relation(fields: [homeId], references: [id], onDelete: Cascade)
  elder        ElderProfile @relation(fields: [elderId], references: [id], onDelete: Cascade)
  sourceDevice Device?      @relation(fields: [sourceDeviceId], references: [id])

  @@map("help_triggers")
}

// ============================================================================
// SMART HOME: IOT AUTHENTICATION
// ============================================================================

model IotToken {
  id        String    @id @default(uuid())
  homeId    String
  token     String    @unique // Hashed
  label     String
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@map("iot_tokens")
}

// ============================================================================
// SERVICES & BOOKINGS
// ============================================================================

enum ServiceCategory {
  ELDER_CARE
  HOME_CARE
  REPAIR_SERVICES
}

enum ServiceType {
  PERSONAL_CARE
  COMPANIONSHIP
  MEAL_PREPARATION
  LIGHT_HOUSEKEEPING
  SAFETY_SUPERVISION
  TWENTY_FOUR_SEVEN_CARE
  MEDICATION_MANAGEMENT
  MEMORY_CARE
  HEALTH_MONITORING
  NUTRITION_MEAL_PREP
  ELDER_COMPANIONSHIP
  GENERAL_REPAIRS
  ELECTRICAL_WORK
  PLUMBING_SERVICES
  SAFETY_MODIFICATIONS
  SECURITY_UPGRADES
  HANDYMAN_SERVICES
}

model Service {
  id          String          @id @default(uuid())
  name        String
  category    ServiceCategory
  type        ServiceType
  description String
  price       Float?
  duration    Int?
  isActive    Boolean         @default(true)
  features    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  bookings Booking[]

  @@map("services")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PreferredTime {
  MORNING
  AFTERNOON
  EVENING
  FLEXIBLE
}

model Booking {
  id            String        @id @default(uuid())
  fullName      String
  email         String
  phone         String
  serviceId     String?
  serviceType   String
  preferredDate DateTime
  preferredTime PreferredTime
  address       String?
  specialNeeds  String?
  status        BookingStatus @default(PENDING)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  service Service? @relation(fields: [serviceId], references: [id])

  @@map("bookings")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  replied   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

// ============================================================================
// CARE PLANS & TASKS
// ============================================================================

model CarePlan {
  id          String   @id @default(uuid())
  elderId     String   @unique
  title       String
  description String?
  goals       Json?
  services    Json?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  elder ElderProfile @relation(fields: [elderId], references: [id], onDelete: Cascade)
  tasks CareTask[]

  @@map("care_plans")
}

enum CareTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

enum CareTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model CareTask {
  id          String           @id @default(uuid())
  carePlanId  String
  title       String
  description String?
  assignedTo  String?
  priority    CareTaskPriority @default(MEDIUM)
  status      CareTaskStatus   @default(PENDING)
  dueDate     DateTime
  completedAt DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  carePlan CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)

  @@map("care_tasks")
}

// ============================================================================
// APPOINTMENTS
// ============================================================================

enum AppointmentType {
  MEDICAL_CHECKUP
  THERAPY
  SOCIAL_VISIT
  HOME_SERVICE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id          String            @id @default(uuid())
  elderId     String
  title       String
  type        AppointmentType
  description String?
  location    String?
  startTime   DateTime
  endTime     DateTime
  status      AppointmentStatus @default(SCHEDULED)
  attendees   Json?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  elder ElderProfile @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

// ============================================================================
// MEDICATIONS
// ============================================================================

enum MedicationFrequency {
  ONCE_DAILY
  TWICE_DAILY
  THREE_TIMES_DAILY
  FOUR_TIMES_DAILY
  AS_NEEDED
  WEEKLY
  MONTHLY
  CUSTOM
}

model Medication {
  id          String              @id @default(uuid())
  elderId     String
  name        String
  dosage      String
  frequency   MedicationFrequency
  startDate   DateTime
  endDate     DateTime?
  instructions String?
  sideEffects String?
  prescribedBy String?
  isActive    Boolean             @default(true)
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  elder  ElderProfile      @relation(fields: [elderId], references: [id], onDelete: Cascade)
  doses  MedicationDose[]
  logs   MedicationLog[]

  @@map("medications")
}

enum DoseStatus {
  PENDING
  TAKEN
  MISSED
  SKIPPED
}

model MedicationDose {
  id           String     @id @default(uuid())
  medicationId String
  scheduledAt  DateTime
  takenAt      DateTime?
  status       DoseStatus @default(PENDING)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@map("medication_doses")
}

// ============================================================================
// NOTES & DOCUMENTS
// ============================================================================

enum NoteType {
  GENERAL
  MEDICAL
  CARE_PLAN
  INCIDENT
  PROGRESS
  FAMILY_COMMUNICATION
}

model Note {
  id          String   @id @default(uuid())
  elderId     String
  authorId    String
  type        NoteType @default(GENERAL)
  title       String
  content     String
  isPrivate   Boolean  @default(false)
  tags        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notes")
}

// ============================================================================
// 24/7 EMERGENCY MONITORING & ALERTING SYSTEM
// ============================================================================

enum HealthcareProviderType {
  HOSPITAL
  CLINIC
  PRIMARY_CARE
  SPECIALIST
  URGENT_CARE
  EMERGENCY_ROOM
}

model HealthcareProvider {
  id       String                  @id @default(uuid())
  elderId  String
  type     HealthcareProviderType
  name     String
  email    String?
  phone    String?
  address  String?
  city     String?
  state    String?
  zipCode  String?
  priority Int                     @default(5) // 1 = highest priority
  active   Boolean                 @default(true)
  notes    String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  elder ElderProfile @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("healthcare_providers")
}

enum EmergencyServiceType {
  POLICE
  FIRE
  AMBULANCE
  EMERGENCY_DISPATCH
}

model EmergencyService {
  id        String               @id @default(uuid())
  elderId   String
  type      EmergencyServiceType
  name      String               // e.g., "City Police Department"
  email     String?
  phone     String               // Emergency contact number
  address   String?
  city      String?
  state     String?
  zipCode   String?
  active    Boolean              @default(true)
  notes     String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  elder ElderProfile @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("emergency_services")
}

enum NotificationMethod {
  EMAIL
  SMS
  PHONE_CALL
  PUSH
  DISPATCH
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  QUEUED
}

model EmergencyNotification {
  id               String             @id @default(uuid())
  alertId          String
  recipientType    String             // HOSPITAL, CLINIC, POLICE, FAMILY, etc.
  recipientName    String
  recipientContact String             // Email or phone
  method           NotificationMethod
  status           NotificationStatus @default(PENDING)
  metadata         Json?              // Additional info about the notification
  sentAt           DateTime           @default(now())
  deliveredAt      DateTime?
  failedReason     String?
  createdAt        DateTime           @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@map("emergency_notifications")
}

model EmergencyReport {
  id          String        @id @default(uuid())
  elderId     String
  alertType   String        // MEDICAL, FALL, VITAL_ABNORMAL, etc.
  severity    AlertSeverity
  title       String
  summary     String
  reportData  Json          // Comprehensive report with all patient data
  generatedAt DateTime      @default(now())

  elder ElderProfile @relation(fields: [elderId], references: [id], onDelete: Cascade)
  dispatches EmergencyDispatch[]

  @@map("emergency_reports")
}

enum DispatchPriority {
  IMMEDIATE
  URGENT
  ROUTINE
}

enum DispatchStatus {
  PENDING
  DISPATCHED
  EN_ROUTE
  ON_SCENE
  COMPLETED
  CANCELLED
}

model EmergencyDispatch {
  id               String           @id @default(uuid())
  elderId          String
  reportId         String
  serviceType      String           // POLICE, FIRE, AMBULANCE
  serviceName      String
  serviceContact   String?
  priority         DispatchPriority
  status           DispatchStatus   @default(PENDING)
  incidentType     String
  incidentSeverity AlertSeverity
  location         Json             // Address, coordinates
  patientInfo      Json             // Name, age, gender, blood type
  notes            String?
  dispatchedAt     DateTime?
  arrivedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  elder  ElderProfile    @relation(fields: [elderId], references: [id], onDelete: Cascade)
  report EmergencyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("emergency_dispatches")
}

model MedicalHistory {
  id              String   @id @default(uuid())
  elderId         String   @unique
  conditions      Json     @default("[]") // Array of medical conditions
  allergies       Json     @default("[]") // Array of allergies
  surgeries       Json     @default("[]") // Array of past surgeries
  chronicDiseases Json     @default("[]") // Array of chronic diseases
  familyHistory   Json?    // Family medical history
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  elder ElderProfile @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("medical_history")
}

model EmergencyContact {
  id           String   @id @default(uuid())
  elderId      String
  name         String
  relationship String   // "Daughter", "Son", "Spouse", etc.
  phone        String
  email        String?
  address      String?
  city         String?
  state        String?
  zipCode      String?
  isPrimary    Boolean  @default(false)
  active       Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  elder ElderProfile @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

// ============================================================================
// 24/7 MONITORING CONFIGURATION
// ============================================================================

model MonitoringConfig {
  id                    String   @id @default(uuid())
  elderId               String   @unique
  enabled               Boolean  @default(true)

  // Vital thresholds (JSON with custom ranges)
  vitalThresholds       Json?

  // Alert preferences
  notifyFamily          Boolean  @default(true)
  notifyHealthcare      Boolean  @default(true)
  notifyEmergency       Boolean  @default(true)

  // Quiet hours (no non-critical alerts)
  quietHoursStart       String?  // e.g., "22:00"
  quietHoursEnd         String?  // e.g., "07:00"

  // Monitoring intervals
  vitalCheckInterval    Int      @default(300) // seconds (5 min default)
  inactivityTimeout     Int      @default(3600) // seconds (1 hour default)

  // Emergency escalation
  autoEscalateCritical  Boolean  @default(true)
  escalationDelay       Int      @default(300) // seconds (5 min before escalation)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  elder ElderProfile @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("monitoring_configs")
}

// ============================================================================
// VOICE CONTROL & RECOGNITION
// ============================================================================

model VoiceCommand {
  id         String   @id @default(uuid())
  elderId    String
  homeId     String
  transcript String   // Speech-to-text transcription
  confidence Float    // Recognition confidence (0.0 - 1.0)
  timestamp  DateTime @default(now())

  elder ElderProfile @relation(fields: [elderId], references: [id], onDelete: Cascade)
  home  Home         @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@map("voice_commands")
  @@index([elderId, timestamp])
}

model VoiceExecution {
  id          String   @id @default(uuid())
  elderId     String
  homeId      String
  transcript  String   // Original voice command
  action      String   // Parsed action type
  status      String   // SUCCESS, FAILED, PARTIAL
  result      Json?    // Execution result details
  executedAt  DateTime @default(now())

  elder ElderProfile @relation(fields: [elderId], references: [id], onDelete: Cascade)
  home  Home         @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@map("voice_executions")
  @@index([elderId, executedAt])
}

model VoicePreference {
  id                  String   @id @default(uuid())
  elderId             String   @unique
  enabled             Boolean  @default(true)
  language            String   @default("en-US")
  voiceSpeed          Float    @default(1.0)  // Speech output speed
  voiceVolume         Float    @default(0.8)  // Speech output volume
  confirmCommands     Boolean  @default(false) // Ask for confirmation before executing
  enableEmergency     Boolean  @default(true)  // Allow emergency voice commands
  enableDeviceControl Boolean  @default(true)  // Allow device control
  wakeWord            String?  // Custom wake word (e.g., "Hey ElderCare")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  elder ElderProfile @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("voice_preferences")
}

// ============================================================================
// AI COMPANION & PERSONAL ASSISTANT
// ============================================================================

model CompanionSettings {
  id                   String   @id @default(uuid())
  elderId              String   @unique
  enabled              Boolean  @default(true)

  // Personality customization
  personalityName      String   @default("Emma")
  personalityTraits    Json     @default("[]") // Array of personality traits
  personalityGender    String?  @default("female")

  // Features
  voiceEnabled         Boolean  @default(true)   // Text-to-speech responses
  proactiveReminders   Boolean  @default(true)   // Send automatic reminders
  emotionalSupport     Boolean  @default(true)   // Provide companionship
  conversationHistory  Boolean  @default(true)   // Remember past conversations

  // Reminder preferences
  medicationReminders  Boolean  @default(true)
  appointmentReminders Boolean  @default(true)
  exerciseReminders    Boolean  @default(true)
  checkInFrequency     String?  @default("daily") // daily, twice_daily, weekly

  // Communication style
  responseLength       String   @default("medium") // short, medium, long
  formality            String   @default("friendly") // formal, friendly, casual

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  elder ElderProfile @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("companion_settings")
}

model CompanionConversation {
  id                 String   @id @default(uuid())
  elderId            String
  userMessage        String   // What the elder said
  companionResponse  String   // What the AI responded
  sentiment          String?  // POSITIVE, NEUTRAL, NEGATIVE, CONCERNED
  actionTriggered    Json?    // Any actions triggered (reminders, calls, etc.)
  timestamp          DateTime @default(now())

  elder ElderProfile @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("companion_conversations")
  @@index([elderId, timestamp])
}

model CompanionReminder {
  id            String   @id @default(uuid())
  elderId       String
  reminderType  String   // MEDICATION, APPOINTMENT, EXERCISE, CHECK_IN, CUSTOM
  title         String
  message       String
  scheduledFor  DateTime
  delivered     Boolean  @default(false)
  deliveredAt   DateTime?
  acknowledged  Boolean  @default(false)
  metadata      Json?    // Additional reminder data
  createdAt     DateTime @default(now())

  elder ElderProfile @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("companion_reminders")
  @@index([elderId, scheduledFor])
}

model CompanionActivity {
  id           String   @id @default(uuid())
  elderId      String
  activityType String   // CONVERSATION, REMINDER, EXERCISE, CALL, MOOD_CHECK
  description  String
  mood         String?  // How the elder seemed during this activity
  duration     Int?     // Duration in seconds
  timestamp    DateTime @default(now())

  elder ElderProfile @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("companion_activities")
  @@index([elderId, timestamp])
}

// ============================================================================
// ML PREDICTIONS & ANALYTICS
// ============================================================================

model MLPrediction {
  id              String   @id @default(uuid())
  elderId         String
  predictionType  String   // FALL_RISK, HEALTH_DETERIORATION, MEDICATION_ADHERENCE, COMPREHENSIVE
  predictions     Json     // Structured prediction results
  confidence      Float?   // Overall confidence score
  generatedAt     DateTime @default(now())
  validUntil      DateTime? // When prediction expires

  elder ElderProfile @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("ml_predictions")
  @@index([elderId, generatedAt])
}

model GaitAnalysis {
  id              String   @id @default(uuid())
  elderId         String
  gaitSpeed       Float    // meters per second
  stepLength      Float    // centimeters
  cadence         Float    // steps per minute
  symmetry        Float    // 0-100
  stability       Float    // 0-100
  abnormalities   Json     @default("[]") // Array of detected issues
  recommendations Json     @default("[]") // Array of recommendations
  analyzedAt      DateTime @default(now())

  elder ElderProfile @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("gait_analysis")
  @@index([elderId, analyzedAt])
}

model LocationTracking {
  id        String   @id @default(uuid())
  elderId   String
  location  Json     // { latitude, longitude, accuracy }
  address   String?
  activity  String?  // WALKING, STATIONARY, DRIVING
  timestamp DateTime @default(now())

  elder ElderProfile @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@map("location_tracking")
  @@index([elderId, timestamp])
}

model MedicationLog {
  id          String     @id @default(uuid())
  medicationId String?
  elderId     String?
  scheduledAt DateTime
  recordedAt  DateTime   @default(now())
  status      DoseStatus @default(PENDING)
  notes       String?

  medication Medication? @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  @@map("medication_logs")
  @@index([scheduledAt])
}

// ============================================================================
// IOT DEVICES & EDGE COMPUTING
// ============================================================================

enum DeviceType {
  MEDICAL_WEARABLE
  ENVIRONMENTAL_SENSOR
  SAFETY_DEVICE
  ACTIVITY_MONITOR
  CAMERA
  ROBOT
  GATEWAY
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  ERROR
}

enum DeviceProtocol {
  BLE
  ZIGBEE
  ZWAVE
  WIFI
  LORAWAN
  ETHERNET
}

model Device {
  id                  String         @id @default(uuid())
  homeId              String?
  type                DeviceType
  protocol            DeviceProtocol
  name                String
  manufacturer        String?
  modelNumber         String?
  serialNumber        String?
  firmwareVersion     String?
  status              DeviceStatus   @default(OFFLINE)
  batteryLevel        Float?         // 0-100
  lastSeen            DateTime?
  location            String?        // Room or area
  capabilities        Json?          // Device capabilities
  configuration       Json?          // Device configuration
  metadata            Json?
  encryptionEnabled   Boolean        @default(false)
  lastSecurityUpdate  DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  home    Home?          @relation(fields: [homeId], references: [id], onDelete: SetNull)
  readings SensorReading[]

  @@map("devices")
}

model SensorReading {
  id         String   @id @default(uuid())
  deviceId   String
  sensorType String   // TEMPERATURE, HUMIDITY, MOTION, DOOR, etc.
  value      Float
  unit       String?
  metadata   Json?
  timestamp  DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("sensor_readings")
  @@index([deviceId, timestamp])
}

model MotionSensor {
  id        String   @id @default(uuid())
  location  String
  intensity Float    // 0-1
  timestamp DateTime @default(now())

  @@map("motion_sensors")
}

model Camera {
  id         String   @id @default(uuid())
  homeId     String
  location   String
  active     Boolean  @default(true)
  privacyMode Boolean @default(false)
  createdAt  DateTime @default(now())

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@map("cameras")
}

model EdgeGateway {
  id              String   @id @default(uuid())
  homeId          String
  name            String
  ipAddress       String
  status          String   @default("ONLINE") // ONLINE, OFFLINE, SYNCING
  lastHeartbeat   DateTime?
  capabilities    Json?    // Processing capabilities
  resources       Json?    // CPU, memory, storage
  version         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("edge_gateways")
}

// ============================================================================
// ROBOTICS
// ============================================================================

enum RobotType {
  COMPANION
  TELEPRESENCE
  ASSISTANT
  THERAPEUTIC
}

model Robot {
  id              String     @id @default(uuid())
  homeId          String?
  type            RobotType
  name            String
  manufacturer    String?
  modelNumber     String?
  status          String     @default("OFFLINE") // ONLINE, OFFLINE, CHARGING, MAINTENANCE
  batteryLevel    Float?     // 0-100
  location        String?
  capabilities    Json?      // speak, listen, move, fetch, etc.
  configuration   Json?
  lastCommand     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("robots")
}

// ============================================================================
// TELEMEDICINE
// ============================================================================

enum ConsultationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model VideoConsultation {
  id               String              @id @default(uuid())
  elderId          String
  doctorId         String?
  doctorName       String
  scheduledAt      DateTime
  startedAt        DateTime?
  endedAt          DateTime?
  duration         Int?                // minutes
  status           ConsultationStatus  @default(SCHEDULED)
  roomId           String?             // Twilio/Agora room ID
  recordingUrl     String?
  notes            String?
  diagnosis        String?
  prescriptions    Json?               // Array of prescriptions
  followUpRequired Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@map("video_consultations")
}

model RPMSession {
  id                String   @id @default(uuid())
  elderId           String
  monthYear         String   // "2024-05" for May 2024
  minutesLogged     Int      @default(0)
  cptCode99453      Boolean  @default(false) // Device setup
  cptCode99454      Boolean  @default(false) // Device supply
  cptCode99457      Boolean  @default(false) // First 20 minutes
  cptCode99458Count Int      @default(0)     // Additional 20-minute blocks
  billable          Boolean  @default(false)
  billedAt          DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("rpm_sessions")
  @@unique([elderId, monthYear])
}

// ============================================================================
// BLOCKCHAIN
// ============================================================================

model BlockchainRecord {
  id                String   @id @default(uuid())
  elderId           String
  recordType        String   // VITAL, MEDICATION, APPOINTMENT, etc.
  dataHash          String   // Hash of the encrypted data
  ipfsHash          String?  // IPFS hash for encrypted data storage
  blockchainTxHash  String   // Transaction hash on blockchain
  blockNumber       Int?
  smartContractAddr String?
  encryptionKey     String?  // Encrypted with recipient's public key
  createdAt         DateTime @default(now())

  @@map("blockchain_records")
  @@index([elderId])
}

model DataAccessLog {
  id             String   @id @default(uuid())
  elderId        String
  accessorUserId String
  accessorType   String   // FAMILY, DOCTOR, CAREGIVER, SYSTEM
  resourceType   String   // VITALS, MEDICATIONS, MEDICAL_HISTORY
  resourceId     String?
  action         String   // READ, WRITE, UPDATE, DELETE
  granted        Boolean
  reason         String?
  ipAddress      String?
  timestamp      DateTime @default(now())

  @@map("data_access_logs")
  @@index([elderId, timestamp])
}

// ============================================================================
// ZERO-TRUST SECURITY
// ============================================================================

model AccessLog {
  id           String   @id @default(uuid())
  userId       String
  resourceId   String
  resourceType String
  action       String
  granted      Boolean
  reason       String?
  ipAddress    String?
  deviceId     String?
  location     Json?    // { latitude, longitude }
  userAgent    String?
  timestamp    DateTime @default(now())

  @@map("access_logs")
  @@index([userId, timestamp])
}

model AuthAttempt {
  id        String   @id @default(uuid())
  userId    String?
  email     String?
  ipAddress String
  success   Boolean
  failReason String?
  timestamp DateTime @default(now())

  @@map("auth_attempts")
  @@index([ipAddress, timestamp])
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  role   String // FAMILY_MEMBER, HEALTHCARE_PROVIDER, CAREGIVER, ADMIN

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_roles")
  @@unique([userId, role])
}

model EncryptionKey {
  id         String   @id @default(uuid())
  userId     String   @unique
  publicKey  String   // RSA public key (PEM format)
  privateKey String?  // Encrypted private key (optional, user-controlled)
  algorithm  String   @default("rsa-4096")
  createdAt  DateTime @default(now())
  rotatedAt  DateTime?

  @@map("encryption_keys")
}

// ============================================================================
// ANALYTICS & METRICS
// ============================================================================

model PlatformMetric {
  id        String   @id @default(uuid())
  metricType String  // API_LATENCY, ERROR_RATE, ACTIVE_USERS, etc.
  value     Float
  unit      String?
  metadata  Json?
  timestamp DateTime @default(now())

  @@map("platform_metrics")
  @@index([metricType, timestamp])
}

// ============================================================================
// NLU & VOICE HEALTH
// ============================================================================

model NLUAnalysis {
  id          String   @id @default(uuid())
  elderId     String
  input       String   // Original text/speech
  intents     Json     // Detected intents with confidence
  entities    Json     // Extracted entities
  emotions    Json     // Detected emotions
  suggestions Json?    // Contextual suggestions
  urgency     String?  // LOW, MEDIUM, HIGH, CRITICAL
  timestamp   DateTime @default(now())

  @@map("nlu_analysis")
  @@index([elderId, timestamp])
}

model VoiceHealthMetrics {
  id                  String   @id @default(uuid())
  elderId             String
  pitchMean           Float?
  pitchVariability    Float?
  speakingRate        Float?
  hesitationScore     Float?
  clarityScore        Float?
  respiratoryScore    Float?
  cognitiveScore      Float?
  emotionalScore      Float?
  parkinsonsScore     Float?
  strokeRiskScore     Float?
  overallRiskLevel    String?  // LOW, MEDIUM, HIGH, CRITICAL
  concerns            Json?    // Array of concerns
  recommendations     Json?    // Array of recommendations
  timestamp           DateTime @default(now())

  @@map("voice_health_metrics")
  @@index([elderId, timestamp])
}

model VoiceBaseline {
  id               String   @id @default(uuid())
  elderId          String   @unique
  baselineMetrics  Json     // Average voice characteristics
  sampleCount      Int      @default(0)
  lastUpdated      DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@map("voice_baselines")
}
