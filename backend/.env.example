# Copy to .env and fill in real values. Never commit .env.

# Database
DATABASE_URL="postgresql://eldercare:CHANGE_ME@localhost:5432/eldercare_db?schema=public"

# Server
PORT=9401
HOST=0.0.0.0
NODE_ENV=development

# JWT - generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# IoT Gateway token signing secret
IOT_TOKEN_SECRET=

# CORS
FRONTEND_URL=http://localhost:9400

# Email (SendGrid). Leave SENDGRID_API_KEY blank to log emails instead of sending.
SENDGRID_API_KEY=
EMAIL_FROM=noreply@eldercare.com
EMAIL_ADMIN=

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Error Tracking (Sentry)
SENTRY_DSN=
SENTRY_ENABLED=false
APP_VERSION=1.0.0

# Stripe (test keys for development only)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# WebSocket
WS_PORT=9402
WS_PATH=/socket.io

# Redis (optional, for WebSocket scaling)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=false
